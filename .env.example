# Copy to .env and paste your deployment configuration into that local file.
# Existing website and core-catalog URLs are independent of these settings.
# Shell-compatible syntax: quote values containing spaces.

# Public connection defaults included in the APK.
FIRESPOT_COACH_ENDPOINT=
FIRESPOT_CLOUD_ENDPOINT=
FIRESPOT_COGNITO_REGION=
FIRESPOT_COGNITO_CLIENT_ID=

# AWS CLI profile/region for your deployment tools. Use local CLI authentication.
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Coach stack deployment inputs. Enter these in sam deploy --guided.
FIRESPOT_MODEL_ID=
FIRESPOT_MODEL_ARN=
FIRESPOT_KNOWLEDGE_BASE_ID=

# Optional existing distribution signing key (keep all values private).
# FIRESPOT_KEYSTORE=/private/path/firespot-release.p12
# FIRESPOT_STORE_PASSWORD=
# FIRESPOT_KEY_PASSWORD=

# Coach session tokens and Cognito passwords are entered in the app.
# Never put AWS access keys, session tokens, or passwords in version control/chat.
