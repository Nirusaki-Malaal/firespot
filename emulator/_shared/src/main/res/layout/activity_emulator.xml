<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Emulation Video Surface -->
    <SurfaceView
        android:id="@+id/emulator_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false" />

    <!-- In-Game TV Overlay Menu (Hidden by default, triggered by Menu button) -->
    <LinearLayout
        android:id="@+id/overlay_menu_container"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/overlay_dim"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IN-GAME MENU"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/accent_gold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_menu_resume"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_resume"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save State (Slot 0)"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_load"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Load State (Slot 0)"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_slot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Change Slot: 0"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_preset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Preset: Balanced (60fps)"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_reset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_reset"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_menu_exit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/menu_exit"
            android:textColor="@color/unsupported_red"
            android:background="@drawable/card_focus_selector"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
